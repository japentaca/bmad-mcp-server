# BMAD Web App
BMAD_ACCESS_TOKEN=changeme
BMAD_DB_URL=sqlite://./bmad.db
# Alternative: path-only SQLite (same DB, simpler config)
# BMAD_SQLITE_PATH=./bmad.db
# WebSocket server port (default: 3001)
BMAD_WS_PORT=3001
# OpenCode SDK (required for story execution)
# Install: npm install @opencode-ai/sdk
OPECODE_HOST=http://localhost:4096
