---
import AppSidebar from '@components/AppSidebar.vue';

interface Props {
  title: string;
}

const { title } = Astro.props;
const isLoggedIn = Astro.locals.session?.valid ?? false;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — BMAD Manager</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="https://unpkg.com/primeflex@3.3.1/primeflex.min.css" />
  <link rel="stylesheet" href="https://unpkg.com/primeicons@7.0.0/primeicons.css" />
  <link id="primevue-theme" rel="stylesheet" href="https://unpkg.com/primevue/resources/themes/lara-light-blue/theme.css" />
  <link id="primevue-base" rel="stylesheet" href="https://unpkg.com/primevue/resources/primevue.min.css" />
  <style is:global>
    body { margin: 0; padding: 0; font-family: var(--font-family); background-color: var(--surface-ground); color: var(--text-color); }
  </style>
</head>
<body>
  {isLoggedIn ? (
    <div style="display: flex; min-height: 100vh;">
      <AppSidebar client:load />
      <main style="flex: 1; padding: 1.5rem; overflow: auto;">
        <h1 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem;">{title}</h1>
        <slot />
      </main>
    </div>
  ) : (
    <main style="min-height: 100vh; display: flex; align-items: center; justify-content: center;">
      <slot />
    </main>
  )}
</body>
</html>
