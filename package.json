{
  "name": "bmad-workspace",
  "version": "3.1.0",
  "private": true,
  "description": "BMAD monorepo - MCP server, web management app, shared libraries",
  "workspaces": [
    "packages/shared",
    "packages/mcp",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build -w packages/shared && npm run build -w packages/mcp && npm run build -w packages/web",
    "build:shared": "npm run build -w packages/shared",
    "build:mcp": "npm run build -w packages/mcp",
    "build:web": "npm run build -w packages/web",
    "dev:web": "npm run dev -w packages/web",
    "lint": "eslint packages --ext .ts,.js,.mjs",
    "lint:fix": "eslint packages --ext .ts,.js,.mjs --fix",
    "format": "prettier --write .",
    "test": "npm run test -w packages/mcp"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/node": "^24.9.1",
    "eslint": "^9.17.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
